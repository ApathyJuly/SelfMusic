# 复制此文件为 keystore.properties，并填入你自己的签名信息。
# keystore.properties 已被 .gitignore 忽略，不会提交到仓库。
#
# 生成 keystore（只需一次，之后永远用同一个）：
#   keytool -genkeypair -v -keystore C:\keys\selfmusic.jks ^
#     -alias selfmusic -keyalg RSA -keysize 2048 -validity 10000
#
# ⚠️ 这个 jks 文件必须备份两处，丢了之后所有新版本都无法覆盖安装。

storeFile=C:/keys/selfmusic.jks
storePassword=你的keystore密码
keyAlias=selfmusic
keyPassword=你的key密码

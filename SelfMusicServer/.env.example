# MySQL 8 / 5.7
MYSQL_DATABASE=selfmusic
MYSQL_USER=selfmusic
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

# JWT / media signing secrets (at least 32 characters, use random values)
JWT_SECRET=replace-with-a-long-random-jwt-secret-0123456789
MEDIA_TOKEN_SECRET=replace-with-a-long-random-media-secret-0123456789

# MinIO (S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_BUCKET=selfmusic
S3_REGION=us-east-1

# Leave * for native Android only; set a specific origin if a web client is added.
CORS_ALLOWED_ORIGINS=*
